# ─── Discord ────────────────────────────────────────────────
# Token du bot (Discord Developer Portal → Bot → Reset Token)
DISCORD_TOKEN=
# Application ID (Developer Portal → General Information)
CLIENT_ID=
# Secret OAuth2 (Developer Portal → OAuth2) — requis pour le dashboard
CLIENT_SECRET=
# Optionnel : enregistre les commandes uniquement sur ce serveur (instantané, utile en dev)
DEV_GUILD_ID=
# Optionnel : active l'intent privilégié "Presence" pour afficher les membres en ligne dans /stats
ENABLE_PRESENCE_INTENT=false

# ─── Base de données ───────────────────────────────────────
DATABASE_URL=postgresql://coderouge:coderouge@localhost:5432/coderouge?schema=public

# ─── Dashboard ─────────────────────────────────────────────
# URL publique du dashboard (utilisée pour OAuth2 et le contrôle d'origine CSRF)
DASHBOARD_URL=http://localhost:5173
# Port de l'API du dashboard
DASHBOARD_PORT=3000
# Secret de signature des cookies — au moins 32 caractères aléatoires
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ─── Divers ────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
