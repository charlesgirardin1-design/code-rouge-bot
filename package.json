{
  "name": "code-rouge-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Bot Discord de modération, administration et sécurité avec dashboard web",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "dashboard/frontend"
  ],
  "scripts": {
    "postinstall": "prisma generate",
    "dev:bot": "tsx watch src/bot/index.ts",
    "dev:api": "tsx watch src/dashboard/index.ts",
    "dev:web": "npm run dev -w dashboard/frontend",
    "build": "prisma generate && tsc -p tsconfig.build.json && npm run build -w dashboard/frontend",
    "start:bot": "node dist/bot/index.js",
    "start:api": "node dist/dashboard/index.js",
    "deploy-commands": "tsx src/bot/scripts/deployCommands.ts",
    "invite-url": "tsx src/bot/scripts/inviteUrl.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w dashboard/frontend",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.5",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.6",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true
  }
}
